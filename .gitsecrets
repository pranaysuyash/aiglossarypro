# Git secrets patterns to prevent accidental commits
# Install git-secrets: brew install git-secrets
# Setup: git secrets --install && git secrets --register-aws

# API Keys
sk-proj-[A-Za-z0-9_-]+
AKIA[0-9A-Z]{16}
AIza[0-9A-Za-z_-]{35}
xox[baprs]-[0-9A-Za-z]{10,48}
ghp_[0-9a-zA-Z]{36}
ghr_[0-9a-zA-Z]{36}

# AWS Patterns
aws_access_key_id\s*=\s*[A-Z0-9]{20}
aws_secret_access_key\s*=\s*[A-Za-z0-9/+=]{40}

# Database URLs
postgres://[^:]+:[^@]+@[^/]+/[^\s]+
mongodb://[^:]+:[^@]+@[^/]+/[^\s]+
mysql://[^:]+:[^@]+@[^/]+/[^\s]+

# Private Keys
-----BEGIN\s+.*PRIVATE\s+KEY-----
-----BEGIN\s+RSA\s+PRIVATE\s+KEY-----
-----BEGIN\s+OPENSSH\s+PRIVATE\s+KEY-----

# Generic Secrets
[Pp]assword\s*[:=]\s*["'][^"']{8,}["']
[Ss]ecret\s*[:=]\s*["'][^"']{8,}["']
[Tt]oken\s*[:=]\s*["'][^"']{8,}["']
[Aa]pi[_-]?[Kk]ey\s*[:=]\s*["'][^"']{8,}["']

# Specific service patterns
phc_[A-Za-z0-9]{20,}
re_[A-Za-z0-9]{20,}
npg_[A-Za-z0-9]{20,}

# Firebase
firebase.*private_key.*:.*".*\\n.*\\n.*"
client_email.*:.*firebase.*@.*\.iam\.gserviceaccount\.com

# Stripe
sk_live_[0-9a-zA-Z]{24}
sk_test_[0-9a-zA-Z]{24}

# SendGrid
SG\.[0-9A-Za-z\-_]{22}\.[0-9A-Za-z\-_]{43}

# Twilio
AC[a-z0-9]{32}
SK[a-z0-9]{32}

# JWT Secrets
[Jj][Ww][Tt].*[:=].*[A-Za-z0-9+/=]{32,}