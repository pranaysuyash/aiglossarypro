# Debug Dockerfile with extensive logging
# Testing with both Alpine and Debian-based images

# Option 1: Try with Debian-based slim image (more compatible)
FROM node:20-slim

# Install curl for health checks
RUN apt-get update && apt-get install -y curl && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy the simple API files
COPY simple-api.js ./
COPY simple-package.json ./package.json
COPY debug-entrypoint.sh ./

# Make entrypoint executable
RUN chmod +x debug-entrypoint.sh

# Install only production dependencies
RUN npm install --production

# Add debugging info
RUN echo "[BUILD] Node version: $(node --version)" && \
    echo "[BUILD] NPM version: $(npm --version)" && \
    echo "[BUILD] Platform: $(uname -m)" && \
    echo "[BUILD] Files in /app:" && \
    ls -la

# Health check with more verbose output
HEALTHCHECK --interval=30s --timeout=10s --start-period=90s --retries=5 \
  CMD curl -f http://localhost:3001/api/health 2>&1 || (echo "Health check failed" && exit 1)

EXPOSE 3001

ENV NODE_ENV=production
ENV PORT=3001

# Use debug entrypoint
ENTRYPOINT ["/app/debug-entrypoint.sh"]