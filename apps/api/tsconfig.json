{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "incremental": true,
    "tsBuildInfoFile": ".tsbuildinfo",
    "outDir": "dist",
    "rootDir": "src",
    "declaration": true,
    "sourceMap": true,
    "baseUrl": ".",
    "typeRoots": ["../../node_modules/@types", "./src/types"],
    "types": ["node"],
    "paths": {
      "@/*": ["./src/*"],
      "@aiglossarypro/shared": ["../../packages/shared/src/index.ts"],
      "@aiglossarypro/shared/*": ["../../packages/shared/src/*"],
      "@aiglossarypro/database": ["../../packages/database/src/index.ts"],
      "@aiglossarypro/database/*": ["../../packages/database/src/*"],
      "@aiglossarypro/auth": ["../../packages/auth/src/index.ts"],
      "@aiglossarypro/auth/*": ["../../packages/auth/src/*"],
      "@aiglossarypro/config": ["../../packages/config/src/index.ts"],
      "@aiglossarypro/config/*": ["../../packages/config/src/*"]
    }
  },
  "include": ["src/**/*", "src/types/**/*.d.ts", "src/global.d.ts"],
  "exclude": [
    "dist",
    "node_modules",
    "src/**/*.test.ts",
    "src/**/*.spec.ts",
    "src/**/__tests__/**",
    "src/scripts/**",
    "src/test/**",
    "src/**/test*.ts",
    "src/**/*Test.ts",
    "src/**/debug*.ts",
    "src/**/*Debug.ts",
    "src/migrations/**",
    "src/**/*migration*.ts",
    "src/**/*Migration*.ts",
    "src/**/import*.ts",
    "src/**/*Import*.ts",
    "src/**/seed*.ts",
    "src/**/*Seed*.ts",
    "src/index-minimal.ts",
    "src/index-original.ts",
    "src/test-minimal.ts",
    "src/routes/firebaseAuthDebug.ts",
    "src/middleware/performance.ts",
    "src/services/cdnMonitoring.ts",
    
  ],
  "references": [
    { "path": "../../packages/shared" },
    { "path": "../../packages/database" },
    { "path": "../../packages/auth" },
    { "path": "../../packages/config" }
  ]
}